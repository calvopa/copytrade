# Hyperliquid — agent wallet (Settings -> API en app.hyperliquid.xyz / app.hyperliquid-testnet.xyz)
# El agent key puede operar pero NO puede retirar fondos.
HYPERLIQUID_API_PRIVATE_KEY=
HYPERLIQUID_ACCOUNT_ADDRESS=

USE_TESTNET=true

# Trader a copiar (direccion 0x...) — opcional al arrancar, se puede setear
# despues con /leader <address> desde Telegram. Usar pick_leader.py para elegir uno.
LEADER_ADDRESS=

CAPITAL_USDC=100.0
STOP_LOSS_PCT=0.15
POLL_INTERVAL_SECONDS=60
MAX_LEVERAGE_HARD_CAP=50
SLIPPAGE=0.01

# Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
